---
// Contact form (sent through Web3Forms). Used on the contact page and the join page.
import { getSite, type Lang } from '../lib/site';
import { useT } from '../i18n/ui';
const { lang, subject } = Astro.props as { lang: Lang; subject?: string };
const t = useT(lang);
const site = getSite(lang);
const key = site.integrations.web3formsKey;
const subjects = ['general', 'membership', 'partnership', 'donation', 'other'];
---
<form class="form" id="contact" data-sending={t('contact.sending')} data-sent={t('contact.sent')} data-failed={t('contact.failed')} data-subject={subject}>
  {!key && <p class="status err">{t('contact.off')}</p>}
  <input type="hidden" name="access_key" value={key} />
  <input type="hidden" name="from_name" value={site.name} />
  <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" style="display:none" />
  <div class="two">
    <div class="field"><label for="name">{t('contact.name')}</label><input id="name" name="name" required autocomplete="name" /></div>
    <div class="field"><label for="email">{t('contact.email')}</label><input id="email" name="email" type="email" required autocomplete="email" /></div>
  </div>
  <div class="two">
    <div class="field"><label for="phone">{t('contact.phone')}</label><input id="phone" name="phone" type="tel" autocomplete="tel" /></div>
    <div class="field"><label for="subject">{t('contact.subject')}</label>
      <select id="subject" name="subject">{subjects.map((s) => <option value={t(`contact.s.${s}`)} data-key={s}>{t(`contact.s.${s}`)}</option>)}</select>
    </div>
  </div>
  <div class="field"><label for="message">{t('contact.message')}</label><textarea id="message" name="message" required></textarea></div>
  <div><button class="btn btn-primary" type="submit" disabled={!key}>{t('contact.send')}</button></div>
  <p class="status" id="status" role="status" hidden></p>
</form>
<script is:inline>
  (function () {
    var form = document.getElementById('contact');
    var status = document.getElementById('status');
    var wanted = new URLSearchParams(location.search).get('subject') || form.dataset.subject;
    if (wanted) { var opt = form.querySelector('option[data-key="' + wanted + '"]'); if (opt) opt.selected = true; }
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var btn = form.querySelector('button[type=submit]');
      var label = btn.textContent;
      btn.disabled = true; btn.textContent = form.dataset.sending;
      var show = function (ok) {
        status.hidden = false;
        status.className = 'status ' + (ok ? 'ok' : 'err');
        status.textContent = ok ? form.dataset.sent : form.dataset.failed;
        btn.disabled = false; btn.textContent = label;
        if (ok) form.reset();
      };
      fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      }).then(function (r) { return r.json(); }).then(function (j) { show(!!j.success); }).catch(function () { show(false); });
    });
  })();
</script>
